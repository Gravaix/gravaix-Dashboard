# Vorlage für infra/.env auf dem Server.
# Kopieren mit:  cp .env.example .env   – dann die Werte unten ersetzen.
# Die echte .env nie ins Repo committen (steht in .gitignore).

# Passwort der Datenbank. Erzeugen mit:  openssl rand -hex 32
POSTGRES_PASSWORD=hier-ersetzen

# Geheimer Schlüssel für die Login-Sitzungen. Erzeugen mit:  openssl rand -base64 32
BETTER_AUTH_SECRET=hier-ersetzen

# Adresse des Cockpits (nur ändern, wenn sich die Domain ändert)
COCKPIT_URL=https://cockpit.gravaix.de

# --- IONOS-Postfach für den Mail-Bereich im Cockpit --------------------------
# Leer lassen, solange das Postfach noch nicht verbunden werden soll.
MAIL_USER=info@gravaix.de
# Passwort des Postfachs info@gravaix.de (wie in Apple Mail). Ohne Anführungszeichen.
MAIL_PASSWORD=

# --- Externe Backup-Kopie (IONOS Object Storage, Frankfurt) ---------------
# Leer lassen, solange der Object Storage noch nicht eingerichtet ist.
# Werte ohne Anführungszeichen eintragen. Siehe docs/backup.md.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Region und Adresse des Speichers (Frankfurt). Bei Region "de" stattdessen:
#   BACKUP_S3_REGION=de  und  BACKUP_S3_ENDPOINT=https://s3.eu-central-1.ionoscloud.com
BACKUP_S3_REGION=eu-central-4
BACKUP_S3_ENDPOINT=https://s3.eu-central-4.ionoscloud.com
# Passwort, mit dem die Backups VOR dem Hochladen verschlüsselt werden.
# Erzeugen mit:  openssl rand -base64 32   – unbedingt im Passwort-Manager sichern!
BACKUP_CRYPT_PASSWORD=
