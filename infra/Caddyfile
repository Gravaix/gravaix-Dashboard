# Caddy holt sich für jede Adresse automatisch ein kostenloses SSL-Zertifikat.
{
	email info@gravaix.de
}

# Cockpit – Next.js-App im Container "cockpit"
cockpit.gravaix.de {
	encode zstd gzip
	reverse_proxy cockpit:3000
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Kalender – vorerst Platzhalter, später Radicale
cal.gravaix.de {
	respond "Gravaix Kalender – im Aufbau" 200
}
