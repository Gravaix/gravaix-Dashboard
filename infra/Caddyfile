# Caddy holt sich für jede Adresse automatisch ein kostenloses SSL-Zertifikat.
{
	email info@gravaix.de
}

# Cockpit – Next.js-App im Container "cockpit"
cockpit.gravaix.de {
	encode zstd gzip
	reverse_proxy cockpit:3000
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Kalender – Radicale (CalDAV) im Container "radicale", Login über Radicale selbst
cal.gravaix.de {
	encode zstd gzip
	# Apple Kalender sucht den Server unter diesen Adressen
	redir /.well-known/caldav / 301
	redir /.well-known/carddav / 301
	reverse_proxy radicale:5232
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
