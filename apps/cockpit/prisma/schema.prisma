// Datenbank-Schema des Cockpits.
// Die Tabellen user, session, account, verification und twoFactor
// gehören zu Better Auth (Login + Zwei-Faktor).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  twoFactorEnabled Boolean?    @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------------------------------------------------------------------------
// Auftragsboard

enum AuftragStatus {
  ANFRAGE
  ANGEBOT
  PRODUKTION
  VERSAND
  ERLEDIGT
}

model Auftrag {
  id         Int            @id @default(autoincrement())
  titel      String
  kunde      String
  kundeEmail String?
  produkt    String?
  menge      Int?
  /// Gravurtext, Schrift, Position, Farbe … (Freitext)
  gravur     String?
  /// Gesamtpreis netto in Cent (bis Ende 2026 = Endpreis, Kleinunternehmer §19 UStG)
  preisCent  Int?
  /// MwSt.-Satz in Prozent (19 oder 7). Leer = Kleinunternehmer (§19 UStG), keine MwSt.
  mwstSatz   Int?
  status     AuftragStatus  @default(ANFRAGE)
  deadline   DateTime?      @db.Date
  notizen    String?
  erledigtAm DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  dateien    AuftragDatei[]

  /// Verknüpfte Mail: Message-ID bleibt gleich, auch wenn die Mail verschoben wird
  mailMessageId String?
  mailBetreff   String?
  /// Zuletzt bekannter Ort der Mail (Ordner + UID) – nur ein Hinweis, wird beim Öffnen geprüft
  mailOrdner    String?
  mailUid       Int?

  @@index([status])
  @@index([mailMessageId])
  @@map("auftrag")
}

/// Logos, Druckvorlagen, Fotos zum Auftrag. Liegen in der Datenbank,
/// damit sie automatisch im täglichen Backup (auch extern) enthalten sind.
model AuftragDatei {
  id        Int      @id @default(autoincrement())
  auftragId Int
  auftrag   Auftrag  @relation(fields: [auftragId], references: [id], onDelete: Cascade)
  name      String
  typ       String
  groesse   Int
  inhalt    Bytes
  createdAt DateTime @default(now())

  @@index([auftragId])
  @@map("auftrag_datei")
}
